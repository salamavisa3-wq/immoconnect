# Configuration du système MAIn / GA4 Verification
# Copiez ce fichier en .env et remplissez les valeurs.
# NE JAMAIS commiter .env dans git.

# Site à auditer
WEBSITE_URL=https://www.sakeurimmo.com
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Pages critiques à vérifier (séparées par des virgules)
CRITICAL_PATHS=/,/contact,/nos-annonces,/carte,/faq
REQUEST_TIMEOUT=10

# Slack (optionnel)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#sakeurimmo-alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Dashboard web
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me-strong-password
PORT=5000
FLASK_DEBUG=false

# Répertoire de stockage des rapports
REPORT_DIR=reports
