{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakeurimmo",
  "main": "backend/worker-entry.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // require("express") accède à bodyParser.json dès son chargement (avant tout code
  // applicatif), ce qui charge iconv-lite — qui plante au bundling Workers (voir le
  // commentaire dans backend/shims/iconv-lite-stub.js). On remplace le module entier.
  "alias": {
    "iconv-lite": "./backend/shims/iconv-lite-stub.js"
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    // Ces routes précises passent toujours par le Worker (SSR + API) même si un
    // fichier statique du même nom existe dans frontend/ ; tout le reste (CSS/JS/
    // images/autres pages) est servi directement par l'edge, sans invoquer le Worker.
    "run_worker_first": [
      "/annonces.html",
      // Forme sans extension des pages indexables : le Worker la redirige 301 vers .html
      // (même traitement que /blog → /blog.html), pour qu'aucune URL duplicate ne soit
      // indexable hors canonical. Les deux formes sont routées Worker → pas de boucle.
      "/annonces",
      "/categorie/*",
      "/villes/*",
      "/annonce/*",
      "/sitemap.xml",
      "/api/*",
      // Pages statiques indexables (.html = forme canonique). Sans ça, le Asset Worker
      // sert ces pages en clean-links : /x.html → 307 → /x, alors que canonical, sitemap
      // et liens internes utilisent /x.html → URLs du sitemap non stables (voir server.js).
      "/blog",
      "/blog/*",
      "/blog.html",
      "/guides",
      "/guides/*",
      "/guides.html",
      "/forfaits.html",
      "/forfaits",
      "/diaspora.html",
      "/diaspora",
      "/contact.html",
      "/contact"
    ]
  },
  "routes": [
    { "pattern": "sakeurimmo.com", "custom_domain": true },
    { "pattern": "www.sakeurimmo.com", "custom_domain": true }
  ],
  // Non secret — les vraies clés/tokens (Turso, Cloudinary, JWT_SECRET, PayPal, Brevo)
  // se posent avec `wrangler secret put <NOM>`, jamais ici (fichier committé).
  "vars": {
    "NODE_ENV": "production",
    "FRONTEND_URL": "https://sakeurimmo.com",
    "FRAIS_MISE_EN_AVANT_FCFA": "2000",
    "PAYPAL_SANDBOX": "false"
  },
  "observability": {
    "enabled": true
  }
}
