# --- Serveur ---
NODE_ENV=production
PORT=3001
# CORS : le frontend est servi sur le même domaine que l'API
FRONTEND_URL=https://sakeurimmo.com

# --- Sécurité ---
JWT_SECRET=CHANGE_ME_LONGUE_CHAINE_ALEATOIRE
JWT_EXPIRES_IN=7d

# --- Base de données Turso (externe, gratuit) ---
# Récupère les valeurs via : turso db show <nom> --url  et  turso db tokens create <nom>
TURSO_DATABASE_URL=libsql://ton-db-org.turso.io
TURSO_AUTH_TOKEN=CHANGE_ME

# --- Stockage images Cloudinary (externe, gratuit) ---
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# --- Frais propriétaire ---
FRAIS_MISE_EN_AVANT_FCFA=2000

# --- Paiement PayPal (facultatif) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=false

# --- Notifications e-mail Brevo (facultatif) ---
BREVO_API_KEY=
ADMIN_EMAIL=
MAIL_EXPEDITEUR=
