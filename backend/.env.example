# --- Serveur ---
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5500

# --- Sécurité ---
JWT_SECRET=change_moi_avec_une_longue_chaine_aleatoire
JWT_EXPIRES_IN=7d

# --- Frais propriétaire ---
FRAIS_INSCRIPTION_FCFA=5000
FRAIS_MISE_EN_AVANT_FCFA=2000   # prix de la mise en avant (7 jours)

# --- PayTech (agrégateur de paiement sénégalais : Orange Money, Wave, Free Money, cartes) ---
# Créez un compte marchand sur https://paytech.sn pour obtenir ces clés
PAYTECH_API_KEY=votre_api_key_paytech
PAYTECH_API_SECRET=votre_api_secret_paytech
PAYTECH_ENV=test
