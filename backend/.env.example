# --- Serveur ---
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5500

# --- Sécurité ---
JWT_SECRET=change_moi_avec_une_longue_chaine_aleatoire
JWT_EXPIRES_IN=7d

# --- Base de données ---
# Vide en local : utilise un fichier libSQL local (sakeurimmo.db), 0 config.
# En production sur un hébergeur à disque éphémère (Render/Railway/Fly.io) :
# créez une base sur https://turso.tech (gratuit) et renseignez ces 2 valeurs
# (récupérées via `turso db show <nom> --url` et `turso db tokens create <nom>`).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Stockage des images ---
# Vide en local : upload sur disque local ./uploads, 0 config.
# En production (disque éphémère) : créez un compte gratuit sur
# https://cloudinary.com et renseignez ces 3 valeurs (dashboard Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frais propriétaire ---
FRAIS_INSCRIPTION_FCFA=5000
FRAIS_MISE_EN_AVANT_FCFA=2000   # prix de la mise en avant (7 jours)

# --- PayTech (agrégateur de paiement sénégalais ; restreint à Orange Money et Wave) ---
# Créez un compte marchand sur https://paytech.sn pour obtenir ces clés
PAYTECH_API_KEY=votre_api_key_paytech
PAYTECH_API_SECRET=votre_api_secret_paytech
PAYTECH_ENV=test
