# --- Serveur ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# --- Sécurité ---
JWT_SECRET=change_moi_avec_une_longue_chaine_aleatoire
JWT_EXPIRES_IN=7d

# --- Base de données ---
# Vide en local : utilise un fichier libSQL local (sakeurimmo.db), 0 config.
# En production sur un hébergeur à disque éphémère (Render/Railway/Fly.io) :
# créez une base sur https://turso.tech (gratuit) et renseignez ces 2 valeurs
# (récupérées via `turso db show <nom> --url` et `turso db tokens create <nom>`).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Stockage des images ---
# Vide en local : upload sur disque local ./uploads, 0 config.
# En production (disque éphémère) : créez un compte gratuit sur
# https://cloudinary.com et renseignez ces 3 valeurs (dashboard Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frais propriétaire ---
# Les formules d'abonnement (5 000 / 10 000 / 15 000 FCFA pour 5 / 10 / 15
# annonces) sont définies dans backend/forfaits.js — source unique de vérité.
FRAIS_MISE_EN_AVANT_FCFA=2000   # prix de la mise en avant (7 jours)

# --- Notifications e-mail (Brevo, https://app.brevo.com — 300 e-mails/jour gratuits) ---
# Facultatif : sans BREVO_API_KEY, les notifications sont seulement journalisées
# et le reste du site fonctionne normalement.
# ADMIN_EMAIL       : adresse qui reçoit les alertes de paiement à vérifier
# MAIL_EXPEDITEUR   : expéditeur validé dans Brevo (par défaut : ADMIN_EMAIL)
BREVO_API_KEY=
ADMIN_EMAIL=
MAIL_EXPEDITEUR=
